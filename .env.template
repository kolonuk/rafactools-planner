# Copy to .env (not committed) for local overrides, or set these as real
# secrets/env vars in whatever runs test/prod (the dadock stack).

PORT=8080
DB_PATH=/data/rafactools.db

# Required. Random string of at least 32 characters, e.g. `openssl rand -hex 32`.
# Signs CSRF tokens. Changing it makes any form that is open in a browser
# fail once ("Form expired"); logged-in sessions are stored in the database
# and stay valid.
SESSION_KEY=

# Public URL this instance is reachable at, used in verification/invite
# emails. No real domain yet — see TODO.md.
BASE_URL=http://localhost:8080

# Email local-part prefix + domain allowed to claim a NEW squadron
# (snco.<number>@ or oc.<number>@). Invited members can use any address.
CLAIM_DOMAIN=rafac.mod.gov.uk

# false only for plain-http local dev. Must be true (the default) anywhere
# reachable over the network, or session/CSRF cookies aren't marked Secure.
COOKIE_SECURE=true

# SMTP for verification/invite emails. Leave SMTP_HOST blank to log links to
# stdout instead (fine for dev, never for test/prod).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@rafactools-planner.local

# Optional site-wide master admin: can view any squadron read-only. Created and
# kept in step at every start. Set BOTH or neither. The password must be 12-72
# characters and belongs in a SECRET (GitHub variables are plain text); never
# put a real one in this file or the repository.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
