# Copy to .env (not committed) for local overrides, or set these as real
# secrets/env vars in whatever runs the image.

PORT=8080
DB_PATH=/data/rafactools.db

# Required. Random string of at least 32 characters, e.g. `openssl rand -hex 32`.
# Signs CSRF tokens. Changing it makes any form that is open in a browser
# fail once ("Form expired"); logged-in sessions are stored in the database
# and stay valid.
SESSION_KEY=

# Public URL this instance is reachable at, used in verification/invite
# emails. No real domain yet — see TODO.md.
BASE_URL=http://localhost:8080

# Email local-part prefix + domain allowed to claim a NEW squadron
# (snco.<number>@ or oc.<number>@). Invited members can use any address.
CLAIM_DOMAIN=rafac.mod.gov.uk

# false only for plain-http local dev. Must be true (the default) anywhere
# reachable over the network, or session/CSRF cookies aren't marked Secure.
COOKIE_SECURE=true

# SMTP for verification/invite emails. With no mail server at all the site refuses
# to start (set ALLOW_LOG_MAIL=true below for local development only).
# MAIL_PROVIDER picks a preset: smtp (default), cloudflare, gmail,
# google-workspace or ses; a preset fills in the host and port. These are only
# DEFAULTS: the master admin can save different values on the website (Your
# details > Email settings) and a saved value wins. See the docs page "Set up email".
MAIL_PROVIDER=smtp
SES_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@rafactools-planner.local

# Optional site-wide master admin: can view any squadron read-only. Created and
# kept in step at every start. Set BOTH or neither. The password must be 12-72
# characters and belongs in a SECRET (GitHub variables are plain text); never
# put a real one in this file or the repository.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Optional "Report a problem": reports are emailed here (empty = feature off).
# ISSUE_MASKING=true lets people black out parts of a screenshot; set false only
# on a site you run for other people. Reports reuse the SMTP settings above.
ISSUE_EMAIL=
ISSUE_MASKING=true

# Without SMTP_HOST the site refuses to start (it would otherwise write secret
# sign-in and reset links to the log). On a development machine only:
ALLOW_LOG_MAIL=false
# Close the claim-a-squadron form (existing accounts and invites keep working):
DISABLE_SIGNUPS=false
# For ONE start, clear the master admin's two-step sign-in if the app is lost:
MASTER_ADMIN_RESET_2FA=false
